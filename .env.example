# Local Supabase (values printed by `npm run db:start`, or `npx supabase status`).
# Copy to .env.local and fill in. Never commit real keys.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-local-anon-key

# The service role key bypasses RLS. It is not used by this app and must never
# appear in src/.

# Demo user switcher (fake login). When DEMO_MODE=true, the switcher signs in
# as a seeded user on the server with DEMO_PASSWORD. The password is only read
# on the server and never sent to the browser. Seed users use password123.
DEMO_MODE=true
DEMO_PASSWORD=password123
